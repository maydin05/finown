{
  "name": "temp-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --experimental-vm-modules --test tests/*.test.mjs",
    "test:mobile": "playwright test tests/e2e/mobile.spec.js tests/e2e/forms-mobile.spec.js tests/e2e/family-mobile.spec.js tests/e2e/bank-logos.spec.js tests/e2e/card-statements.spec.js tests/e2e/spending-plan.spec.js --reporter=line",
    "test:live": "playwright test tests/e2e/live.spec.js --reporter=line",
    "dev:family-server": "node server/family/local.mjs",
    "test:family-server": "node --test tests/family/*.test.mjs",
    "test:family-server:mobile": "playwright test tests/e2e/family-server.spec.js --config=playwright.family-server.config.js --reporter=line"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.93.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.4.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "dotenv": "^17.2.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^7.2.4"
  }
}
